---
---

<div class="visualizer-container">
    <div class="chart-wrapper">
        <canvas id="normalChart"></canvas>
    </div>
    
    <div class="controls-grid">
        <div class="control-group">
            <label for="meanSlider">Média (<span class="math">\mu</span>): <span id="meanValue" class="value-display">0</span></label>
            <input id="meanSlider" type="range" min="-10" max="10" value="0" step="0.5" class="slider">
        </div>
        
        <div class="control-group">
            <label for="stdDevSlider">Desvio Padrão (<span class="math">\sigma</span>): <span id="stdDevValue" class="value-display">1</span></label>
            <input id="stdDevSlider" type="range" min="0.5" max="5" value="1" step="0.1" class="slider">
        </div>
    </div>
</div>

<script>
    import Chart from 'chart.js/auto';

    document.addEventListener('DOMContentLoaded', () => {
        const canvas = document.getElementById('normalChart') as HTMLCanvasElement;
        if (!canvas) return;

        let normalChart: Chart;

        const meanSlider = document.getElementById('meanSlider') as HTMLInputElement;
        const stdDevSlider = document.getElementById('stdDevSlider') as HTMLInputElement;
        const meanValueSpan = document.getElementById('meanValue') as HTMLSpanElement;
        const stdDevValueSpan = document.getElementById('stdDevValue') as HTMLSpanElement;

        function pdf(x: number, mean: number, stdDev: number) {
            const factor = 1 / (stdDev * Math.sqrt(2 * Math.PI));
            const exponent = -0.5 * Math.pow((x - mean) / stdDev, 2);
            return factor * Math.exp(exponent);
        }

        function initializeOrUpdateChart() {
            const mean = parseFloat(meanSlider.value);
            const stdDev = parseFloat(stdDevSlider.value);

            meanValueSpan.textContent = mean.toFixed(1);
            stdDevValueSpan.textContent = stdDev.toFixed(1);

            const labels = [];
            const data = [];
            const startX = -15; // Fixed range for better visualization of shifts
            const endX = 15;
            const step = (endX - startX) / 100;

            for (let x = startX; x <= endX; x += step) {
                labels.push(x.toFixed(2));
                data.push(pdf(x, mean, stdDev));
            }

            if (normalChart) {
                normalChart.data.labels = labels;
                normalChart.data.datasets[0].data = data;
                normalChart.data.datasets[0].label = `Normal(μ=${mean.toFixed(1)}, σ=${stdDev.toFixed(1)})`;
                normalChart.update();
            } else {
                const ctx = canvas.getContext('2d');
                if(!ctx) return;
                
                normalChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: `Normal(μ=${mean.toFixed(1)}, σ=${stdDev.toFixed(1)})`,
                            data: data,
                            borderColor: 'rgb(37, 99, 235)', // primary color
                            backgroundColor: 'rgba(37, 99, 235, 0.2)',
                            borderWidth: 2,
                            pointRadius: 0,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { 
                                beginAtZero: true, 
                                title: { display: true, text: 'Densidade f(x)' },
                                max: 0.8 // Fixed Y scale so it doesn't jump too much
                            },
                            x: { 
                                title: { display: true, text: 'Valores de x' },
                                ticks: { maxTicksLimit: 11 }
                            }
                        },
                        animation: { duration: 200 },
                        plugins: { 
                            legend: { position: 'top' }, 
                            tooltip: { enabled: false } 
                        }
                    }
                });
            }
        }

        meanSlider.addEventListener('input', initializeOrUpdateChart);
        stdDevSlider.addEventListener('input', initializeOrUpdateChart);

        initializeOrUpdateChart();
    });
</script>

<style>
    .visualizer-container {
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: var(--space-6);
        margin: var(--space-8) 0;
        box-shadow: var(--shadow-sm);
    }

    .chart-wrapper {
        height: 300px;
        width: 100%;
        margin-bottom: var(--space-6);
    }

    .controls-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-6);
        background-color: var(--color-bg);
        padding: var(--space-4);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
    }

    @media (max-width: 600px) {
        .controls-grid {
            grid-template-columns: 1fr;
        }
    }

    .control-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    label {
        font-weight: 500;
        color: var(--color-text);
        display: flex;
        justify-content: space-between;
    }

    .math {
        font-family: var(--font-serif);
        font-style: italic;
    }

    .value-display {
        font-family: var(--font-mono);
        color: var(--color-primary);
        font-weight: 700;
    }

    .slider {
        width: 100%;
        cursor: pointer;
    }
</style>
