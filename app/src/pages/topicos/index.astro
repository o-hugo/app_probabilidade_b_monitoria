---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const topicos = await getCollection('topicos');
// Sort by order
topicos.sort((a, b) => a.data.ordem - b.data.ordem);
---

<Layout title="Tópicos">
	<div class="page-header">
		<h1>Tópicos de Estudo</h1>
		<p>Explore o conteúdo teórico da disciplina Probabilidade B.</p>
	</div>

	<div class="topics-grid">
		{topicos.map((topico) => (
			<a href={`/topicos/${topico.id}`} class="topic-card">
				<div class="topic-number">{topico.data.ordem}</div>
				<div class="topic-content">
					<h2>{topico.data.titulo}</h2>
					<div class="tags">
						{topico.data.tags.slice(0, 3).map((tag) => (
							<span class="tag">{tag}</span>
						))}
						{topico.data.tags.length > 3 && <span class="tag">+{topico.data.tags.length - 3}</span>}
					</div>
				</div>
				<div class="topic-arrow">→</div>
			</a>
		))}
	</div>
</Layout>

<style>
	.page-header {
		margin-bottom: var(--space-8);
	}

	.page-header h1 {
		font-size: 2.5rem;
		margin-bottom: var(--space-2);
	}

	.page-header p {
		font-size: 1.25rem;
		color: var(--color-text-muted);
	}

	.topics-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}

	.topic-card {
		display: flex;
		align-items: center;
		background-color: var(--color-surface);
		padding: var(--space-6);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		text-decoration: none;
		color: var(--color-text);
		transition: all 0.2s;
	}

	.topic-card:hover {
		transform: translateX(10px);
		border-color: var(--color-primary);
		box-shadow: var(--shadow-sm);
	}

	.topic-number {
		font-size: 3rem;
		font-weight: 700;
		color: var(--color-border);
		margin-right: var(--space-6);
		min-width: 50px;
		text-align: center;
	}

	.topic-content {
		flex: 1;
	}

	.topic-card h2 {
		margin: 0 0 var(--space-2) 0;
		font-size: 1.5rem;
		transition: color 0.2s;
	}

	.topic-card:hover h2 {
		color: var(--color-primary);
	}

	.tags {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.tag {
		font-size: 0.75rem;
		padding: 2px 8px;
		background-color: var(--color-bg);
		border-radius: 9999px;
		color: var(--color-text-muted);
	}

	.topic-arrow {
		font-size: 1.5rem;
		color: var(--color-text-muted);
		opacity: 0;
		transition: opacity 0.2s, transform 0.2s;
		transform: translateX(-10px);
	}

	.topic-card:hover .topic-arrow {
		opacity: 1;
		transform: translateX(0);
		color: var(--color-primary);
	}
</style>
